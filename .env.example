# Copie para ".env" e ajuste. Tudo é opcional: sem .env o gerador usa a voz do Edge.

# Provedor de voz: edge | piper | sistema | azure | elevenlabs
TTS_PROVEDOR=edge

# Edge (online, grátis): vozes pt-BR = pt-BR-AntonioNeural, pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural
EDGE_VOZ=pt-BR-AntonioNeural

# Piper (local/offline): baixe antes com `npm run voz:baixar -- faber-medium` (lista: npm run voz:lista)
PIPER_VOZ=faber-medium

# Voz do sistema: deixe vazio para escolher a primeira voz pt-BR (Windows: "Microsoft Maria Desktop", macOS: Luciana, Linux: pt-br)
SISTEMA_VOZ=

# Azure AI Speech (uso comercial; tem cota grátis): https://portal.azure.com → "Speech service"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_VOZ=pt-BR-AntonioNeural

# ElevenLabs (pago): id da voz em https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ=
ELEVENLABS_MODELO=eleven_multilingual_v2

# Pasta onde os vídeos prontos são salvos (padrão: Área de Trabalho/Videos Canal Dark 3D ou ./saida)
SAIDA_DIR=

# Caminho de um Chrome/Edge/Chromium, se o gerador não achar sozinho
NAVEGADOR=
