{
  "name": "gerador-videos-dark-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Gera Shorts/TikToks 3D estilo \"O que acontece se...?\" com narração, legenda e trilha",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "video": "node src/make.mjs",
    "stills": "node src/make.mjs --stills",
    "audio": "node src/make.mjs --so-audio",
    "novo": "node src/novo.mjs",
    "doctor": "node src/doctor.mjs",
    "voz:baixar": "node src/baixar-voz.mjs",
    "voz:lista": "node src/baixar-voz.mjs --lista",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "opentype.js": "^1.3.4",
    "puppeteer-core": "^25.16.0",
    "three": "^0.187.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "~1.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
